# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- LLM ---
# Choose "ollama" for fully local inference, or "openai" for hosted
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-large-en
# Lighter alternative: sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
VECTOR_STORE_PROVIDER=faiss
VECTOR_STORE_PATH=./vector_store

# --- OCR ---
OCR_ENGINE=tesseract
# Alternative: paddleocr

# --- Database ---
DATABASE_URL=postgresql://legallens:legallens@localhost:5432/legallens

# --- Security ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
