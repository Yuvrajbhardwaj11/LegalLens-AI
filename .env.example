# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# --- LLM ---
# "groq" is free and recommended for getting started; "openai" also supported
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings (runs locally, no API key needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
VECTOR_STORE_PROVIDER=faiss
VECTOR_STORE_PATH=./vector_store

# --- OCR ---
OCR_ENGINE=tesseract

# --- Database (only needed once you add persistence beyond the vector store) ---
DATABASE_URL=postgresql://legallens:legallens@localhost:5432/legallens

# --- Security ---
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
